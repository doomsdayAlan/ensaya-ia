# Copia este archivo a .env y rellena lo que uses.
# En la nube, estas mismas claves van en el panel del hosting (Vercel / Netlify / Cloudflare / Railway).
# Vite solo expone al navegador las variables que empiezan por VITE_.

# true = Inicio y el resto de la app piden cuenta (recomendado para presentacion y nube).
# false = se puede entrar como invitado.
# El interruptor de la UI solo existe en desarrollo (import.meta.env.DEV) y escribe
# un override en localStorage; en produccion manda unicamente este valor.
VITE_REQUIRE_AUTH=true

# Opcional. Hoy la app funciona sin backend: cuentas, libretos y ensayos van en
# el navegador. Cuando el proyecto Supabase tenga DNS real, descomenta y rellena.
# VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_PROJECT_ID=tu-project-id
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional. Solo si levantas el backend Python (src/teleprompter).
# Si NO las defines, la app no hace fetch a localhost y usa la heurística del navegador.
# VITE_TELEPROMPTER_URL=http://127.0.0.1:8000
# Compatibilidad con el nombre anterior:
# VITE_TELEPROMPTER_API_URL=http://127.0.0.1:8000

# Opcional. Ollama local para calibrar formato del libreto (qwen2.5:1.5b).
# VITE_OLLAMA_URL=http://127.0.0.1:11434

# IA de notas al finalizar y de segmentar libretos (personajes/escenas) al importar.
# NO uses el prefijo VITE_: la clave no debe ir al navegador.
# gemini (recomendado) | groq | openai | template
AI_PROVIDER=gemini
# Crea una clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Notas del director: AI_MODEL o GEMINI_MODEL. Si no hay valor, gemini-3.5-flash-lite.
# El análisis de voz NO hereda esos nombres: solo INTERPRETATION_MODEL, o gemini-3.5-flash-lite.
# AI_MODEL=gemini-3.5-flash-lite
# INTERPRETATION_MODEL=gemini-3.5-flash-lite
# AI_TIMEOUT_MS=8000
# INTERPRETATION_TIMEOUT_MS=30000
# Opcionales. No van al navegador. Hume y la voz de pago no están activos en esta versión.
# HUME_API_KEY=
# ELEVENLABS_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
