# Copia este archivo a .env y rellena lo que uses.
# En la nube, estas mismas claves van en el panel del hosting (Vercel / Netlify / Cloudflare).
# Vite solo expone al navegador las variables que empiezan por VITE_.

# true = Inicio y el resto de la app piden cuenta (recomendado para presentacion y nube).
# false = se puede entrar como invitado. En Configuracion hay un interruptor que
# sobreescribe este valor en el navegador actual.
VITE_REQUIRE_AUTH=true

# Opcional. Hoy la app funciona sin backend: cuentas, libretos y ensayos van en
# localStorage. Cuando el proyecto Supabase tenga DNS real, descomenta y rellena.
# VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_PROJECT_ID=tu-project-id
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional. El teleprompter FastAPI/Whisper no es necesario para el ensayo web.
# VITE_TELEPROMPTER_API_URL=http://127.0.0.1:8000

# IA de notas al finalizar el ensayo (NO uses el prefijo VITE_: la clave no debe ir al navegador).
# gemini (recomendado) | groq | openai | template
AI_PROVIDER=gemini
# Crea una clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# AI_MODEL=gemini-2.5-flash
# AI_TIMEOUT_MS=8000
# GROQ_API_KEY=
# OPENAI_API_KEY=
